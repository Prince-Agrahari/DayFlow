# Backend-specific environment (copy to .env — never commit secrets)
APP_NAME=DayFlow HRM
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api

# JWT
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL (production / docker-compose)
DATABASE_URL=postgresql://dayflow:dayflow_secret@localhost:5432/dayflow_hrm

# Local tests can use SQLite, for example:
# DATABASE_URL=sqlite:///./dayflow.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TIMEZONE=UTC
WORK_START_HOUR=9
AUTO_CREATE_TABLES=true

# Server-side only — never expose to the frontend
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

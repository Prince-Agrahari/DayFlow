# =============================================================================
# DayFlow HRM — Root Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=DayFlow HRM
APP_ENV=development
DEBUG=true

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://dayflow:dayflow_secret@localhost:5432/dayflow_hrm
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow_secret
POSTGRES_DB=dayflow_hrm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI / Gemini (server-side only — never expose to frontend) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend (Vite — only VITE_ prefixed vars are exposed to browser) ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Docker ---
COMPOSE_PROJECT_NAME=dayflow-hrm
